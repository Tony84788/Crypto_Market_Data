# ============================================================

# Cryptocurrency Market Data Platform

# Git Ignore Rules

# ============================================================

# ------------------------------------------------------------

# Environment variables and secrets

# ------------------------------------------------------------

.env
.env.*
!.env.example

# Google Cloud credentials

# Do not globally ignore JSON files.
# Raw/generated JSON is ignored through the data/ rules above.

# Never commit service account credentials

*service-account*.json
*gcp-credentials*.json

# ------------------------------------------------------------

# Python

# ------------------------------------------------------------

**pycache**/
*.py[cod]
*$py.class
*.so

# Python build/package artifacts

build/
dist/
*.egg-info/
.eggs/

# Coverage

.coverage
.coverage.*
htmlcov/
.pytest_cache/
.tox/
.nox/

# ------------------------------------------------------------

# Virtual environments

# ------------------------------------------------------------

.venv/
venv/
env/
ENV/

# Conda

.conda/

# ------------------------------------------------------------

# Jupyter

# ------------------------------------------------------------

.ipynb_checkpoints/

# ------------------------------------------------------------

# Project-generated data

# ------------------------------------------------------------

data/raw/*
data/processed/*
data/lake/raw/*
data/lake/processed/*

# Keep directory structure

!data/raw/.gitkeep
!data/processed/.gitkeep
!data/lake/raw/.gitkeep
!data/lake/processed/.gitkeep

# ------------------------------------------------------------

# Logs

# ------------------------------------------------------------

logs/
*.log

# Airflow logs

airflow/logs/

# ------------------------------------------------------------

# Airflow runtime/database files

# ------------------------------------------------------------

airflow/airflow.db
airflow/airflow.db-shm
airflow/airflow.db-wal

airflow/unittests.cfg
airflow/webserver_config.py

# Airflow generated files

airflow/**pycache**/
airflow/dags/**pycache**/
airflow/plugins/**pycache**/

# ------------------------------------------------------------

# dbt

# ------------------------------------------------------------

crypto_dbt/target/
crypto_dbt/dbt_packages/
crypto_dbt/logs/
crypto_dbt/.user.yml

# dbt partial parsing artifacts

crypto_dbt/target/partial_parse.msgpack

# ------------------------------------------------------------

# Kafka

# ------------------------------------------------------------

# Local Kafka data if mounted

kafka-data/
kafka-logs/

# ------------------------------------------------------------

# Docker

# ------------------------------------------------------------

.docker/

# ------------------------------------------------------------

# IDEs and editors

# ------------------------------------------------------------

.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

.idea/
*.iml

# Vim

*.swp
*.swo
*~

# ------------------------------------------------------------

# OS generated files

# ------------------------------------------------------------

.DS_Store
Thumbs.db

# ------------------------------------------------------------

# Temporary files

# ------------------------------------------------------------

*.tmp
*.temp
*.bak
*.backup
*.cache

# ------------------------------------------------------------

# Terraform

# ------------------------------------------------------------

.terraform/
*.tfstate
*.tfstate.*
crash.log
crash.*.log

*.tfvars
*.tfvars.json

# Keep example Terraform variables

!*.tfvars.example

# ------------------------------------------------------------

# Secrets / credentials

# ------------------------------------------------------------

*.pem
*.key
*.crt
credentials/
secrets/

# ------------------------------------------------------------

# Local development files

# ------------------------------------------------------------

*.local
.local/

# ------------------------------------------------------------

# macOS / Windows

# ------------------------------------------------------------

.AppleDouble
.LSOverride
ehthumbs.db
Icon?
$RECYCLE.BIN/

# ------------------------------------------------------------

# Project-specific runtime files

# ------------------------------------------------------------

*.pid
*.pid.lock
.DS_Store


*.kilo

IGNORE
├── .env                         # secrets
├── airflow/airflow.db           # Airflow runtime database
├── airflow/airflow.db-shm       # SQLite runtime file
├── airflow/airflow.db-wal       # SQLite runtime file
├── airflow/logs/                # generated logs
├── __pycache__/                 # Python generated files
├── *.pyc
├── data/raw/                    # downloaded raw data
├── data/processed/              # generated Parquet
├── data/lake/                   # generated data lake
├── dbt target/                  # generated dbt artifacts
├── dbt_packages/                # generated dependencies
└── OS/editor temporary files